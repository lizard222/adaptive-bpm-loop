<?xml version="1.0" encoding="UTF-8"?>
<!-- ТЕСТОВЫЙ вариант bpmn/demo/vkr_defense.bpmn — та же структура и ТЕ ЖЕ
     имена шагов/активностей (approve_topics, normcontrol, admission_order,
     defense, remind_*/escalate_*), поэтому mining.control_points.
     VKR_DEFENSE_CONTROL_POINTS переиспользуется без изменений. Единственная
     разница — единица измерения таймера: PT{N}M (МИНУТЫ) вместо P{N}D
     (дни), чтобы можно было вручную пройти напоминание/эскалацию за
     реальные минуты при тестировании через UI, а не ждать дни.

     НЕ для реальных данных/демонстрации темы — только для ручной проверки
     контура (см. TESTING.md, раздел "Быстрый сценарий"). Помечен kind="test"
     в orchestrator/process_registry.py — на "боевой" дашборд (GET
     /dashboard/summary без include_all) не попадает. -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Defs_vkr_defense_fast" targetNamespace="http://adaptive-bpm-loop/vkr_defense_fast">
  <bpmn:process id="vkr_defense_fast" isExecutable="true">

    <bpmn:startEvent id="start"/>
    <bpmn:sequenceFlow id="f0" sourceRef="start" targetRef="approve_topics"/>

    <bpmn:userTask id="approve_topics" name="Утверждение тем ВКР (тест)"/>
    <bpmn:sequenceFlow id="f1" sourceRef="approve_topics" targetRef="normcontrol"/>

    <bpmn:boundaryEvent id="remind_topics_timer" attachedToRef="approve_topics" cancelActivity="false">
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">f'PT{reminder_days}M'</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="f2" sourceRef="remind_topics_timer" targetRef="remind_topics"/>
    <bpmn:scriptTask id="remind_topics" name="Напоминание: утверждение тем">
      <bpmn:script>reminded_topics = True</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:sequenceFlow id="f3" sourceRef="remind_topics" targetRef="end_remind_topics"/>
    <bpmn:endEvent id="end_remind_topics"/>

    <bpmn:boundaryEvent id="escalate_topics_timer" attachedToRef="approve_topics" cancelActivity="true">
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">f'PT{escalation_days}M'</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="f4" sourceRef="escalate_topics_timer" targetRef="escalate_topics"/>
    <bpmn:scriptTask id="escalate_topics" name="Эскалация: утверждение тем">
      <bpmn:script>escalated_topics = True</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:sequenceFlow id="f5" sourceRef="escalate_topics" targetRef="end_escalate_topics"/>
    <bpmn:endEvent id="end_escalate_topics"/>

    <bpmn:userTask id="normcontrol" name="Нормоконтроль (тест)"/>
    <bpmn:sequenceFlow id="f6" sourceRef="normcontrol" targetRef="admission_order"/>

    <bpmn:boundaryEvent id="remind_normcontrol_timer" attachedToRef="normcontrol" cancelActivity="false">
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">f'PT{reminder_days}M'</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="f7" sourceRef="remind_normcontrol_timer" targetRef="remind_normcontrol"/>
    <bpmn:scriptTask id="remind_normcontrol" name="Напоминание: нормоконтроль">
      <bpmn:script>reminded_normcontrol = True</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:sequenceFlow id="f8" sourceRef="remind_normcontrol" targetRef="end_remind_normcontrol"/>
    <bpmn:endEvent id="end_remind_normcontrol"/>

    <bpmn:boundaryEvent id="escalate_normcontrol_timer" attachedToRef="normcontrol" cancelActivity="true">
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">f'PT{escalation_days}M'</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="f9" sourceRef="escalate_normcontrol_timer" targetRef="escalate_normcontrol"/>
    <bpmn:scriptTask id="escalate_normcontrol" name="Эскалация: нормоконтроль">
      <bpmn:script>escalated_normcontrol = True</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:sequenceFlow id="f10" sourceRef="escalate_normcontrol" targetRef="end_escalate_normcontrol"/>
    <bpmn:endEvent id="end_escalate_normcontrol"/>

    <bpmn:userTask id="admission_order" name="Приказ о допуске к защите (тест)"/>
    <bpmn:sequenceFlow id="f11" sourceRef="admission_order" targetRef="defense"/>

    <bpmn:userTask id="defense" name="Защита ВКР (тест)"/>
    <bpmn:sequenceFlow id="f12" sourceRef="defense" targetRef="end_main"/>
    <bpmn:endEvent id="end_main"/>

  </bpmn:process>
</bpmn:definitions>
